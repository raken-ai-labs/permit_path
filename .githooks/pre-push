#!/usr/bin/env bash
# raken-dev-standard v0.6.15: .githooks/pre-push
# sha256: 1dffd34989c9994e200911b1cf05b7a553cd1c493fa4ad214647613634f59654
#
# Antes de cada push: referencias colgantes y el comando de pruebas del repo.
# Se activa con `git config core.hooksPath .githooks` (lo hace bootstrap).
# Nunca --no-verify: si algo falla, se arregla en el mismo cambio.
#
# Configuración del repo en .githooks/config (bash, opcional). El hook la sourcea con
# `set -a`: toda clave que define se exporta, así que llega a los scripts hijo.
#   Las lee el hook:
#     PREPUSH_TEST_CMD      comando de pruebas; vacío = no configurado (se avisa)
#     DELETED_REFS_BASE     base de check-deleted-refs (por defecto origin/main)
#   Las leen los scripts vendorizados (el hook solo las exporta):
#     DELETED_REFS_SRC_RE / DELETED_REFS_SKIP_RE / DELETED_REFS_GENERIC   scripts/check-deleted-refs.sh
#     GATE_REVIEWERS_LINE / GATE_REVIEWER_CMD / GATE_CLAUDE_CONFIG_DIR / GATE_EXTRA_CHECK_CMD    scripts/gate.sh
#   Una clave que no está en estas listas no tiene lector: no cambia nada.
#
#   0 = push sigue · 1 = alguna verificación falló (push bloqueado)
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=/dev/null
if [ -f .githooks/config ]; then set -a; source .githooks/config; set +a; fi

# git pasa por stdin una línea por ref empujado:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Cada ref se verifica contra su sha remoto (o contra DELETED_REFS_BASE si la rama
# es nueva en el remoto o su sha remoto no está en el clon); un borrado de ref no
# se verifica. Sin líneas en stdin (corrida a mano) se verifica el HEAD del checkout.
# Al comando de pruebas se exportan PREPUSH_REMOTE_REF, PREPUSH_LOCAL_SHA y
# PREPUSH_REMOTE_SHA, una corrida por ref (un runner puede atar su resumen al commit
# empujado); un repo cuyo comando no los lee los ignora.
zeros='0000000000000000000000000000000000000000'
base_default="${DELETED_REFS_BASE:-origin/main}"
failed=0
refs=(); saw=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  saw=1
  case "$local_sha" in *[!0]*) ;; *) echo "▶ $remote_ref: borrado de ref, sin verificar"; continue ;; esac
  refs+=("$remote_ref $local_sha $remote_sha")
done
(( saw )) || refs=("HEAD $(git rev-parse HEAD) ${zeros}")

for entry in ${refs[@]+"${refs[@]}"}; do
  read -r remote_ref local_sha remote_sha <<<"$entry"
  base="$base_default"
  case "$remote_sha" in *[!0]*) git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null 2>&1 && base="$remote_sha" ;; esac
  echo "▶ $remote_ref (${local_sha:0:12} contra ${base:0:12})"
  echo "▶ check-deleted-refs"
  bash scripts/check-deleted-refs.sh "$base" "$local_sha" || failed=1

  echo "▶ tests"
  if [ -z "${PREPUSH_TEST_CMD:-}" ]; then
    echo "⚠ PREPUSH_TEST_CMD not configured in .githooks/config — tests not run"
  elif PREPUSH_REMOTE_REF="$remote_ref" PREPUSH_LOCAL_SHA="$local_sha" PREPUSH_REMOTE_SHA="$remote_sha" bash -c "$PREPUSH_TEST_CMD"; then
    echo "✓ tests passed"
  else
    echo "✗ tests failed: $PREPUSH_TEST_CMD"; failed=1
  fi
done

if (( failed )); then
  echo "❌ push blocked: fix the failures above in this change"
  exit 1
fi
echo "✅ pre-push checks passed"
